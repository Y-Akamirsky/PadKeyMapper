# Maintainer: Yaroslav Akamirsky <akamirsky.yaros@gmail.com>
pkgname=pad-key-mapper
pkgver=0.0.1.1
pkgrel=1
pkgdesc="MIDI to Keystroke Mapper for Midi controllers (Python/CustomTkinter)"
arch=('x86_64')
url="https://github.com/Y-Akamirsky/PadKey-Mapper"
license=('GPL3')
depends=('python' 'tk')
makedepends=('python-pip' 'python-setuptools' 'gcc' 'make')
install=pad-key-mapper.install
source=("pad-key-mapper.install" "PR-PKMICON.svg") # Остальные файлы берем локально или из src
sha256sums=('SKIP' 'SKIP')

PKMICON=("PR-PKMICON.svg")

prepare() {
    # Создаем .desktop файл на лету
    cat > pad-key-mapper.desktop <<EOF
[Desktop Entry]
Type=Application
Name=PadKey Mapper
Comment=Turn your Launchpad into a macro keyboard
Exec=pad-key-mapper
Icon=PKMPPR
Terminal=false
Categories=Utility;AudioVideo
EOF

    # Создаем udev правило на лету
    cat > 99-padkey-mapper.rules <<EOF
KERNEL=="uinput", SUBSYSTEM=="misc", OPTIONS+="static_node=uinput", TAG+="uaccess", MODE="0660", GROUP="uinput"
EOF
}

package() {
    # 1. Создаем директории
    # Устанавливаем файлы проекта в /usr/lib/ (стандартное место для библиотек/данных)
    install -d "$pkgdir/usr/lib/$pkgname"
    install -d "$pkgdir/usr/share/applications"
    install -d "$pkgdir/usr/lib/udev/rules.d"

    # 2. Копируем исходный код Python
    cd "$srcdir" || exit 1
    # Копируем PadKeyMapper и папку _internal в /usr/lib/$pkgname/
    # PadKeyMapper - это твой бинарник без расширения
    cp -r _internal/ PadKeyMapper "$pkgdir/usr/lib/$pkgname"

    # 3. Создаем запускающий скрипт в /usr/bin/
    # Он будет запускать PadKeyMapper из папки /usr/lib/pad-key-mapper/

    # Создаем временный скрипт
    cat > "$srcdir/$pkgname" <<EOF
#!/bin/bash
# Переходим в директорию, где лежат все зависимости и основной бинарник
PROGRAM_ROOT="/usr/lib/$pkgname"
cd "\$PROGRAM_ROOT"
# Запускаем твой бинарник PadKeyMapper (без расширения) с помощью интерпретатора Python
exec ./PadKeyMapper "\$@"
EOF
    chmod +x "$pkgdir/usr/lib/$pkgname/PadKeyMapper"

    # Устанавливаем скрипт в /usr/bin/ и даем ему права на исполнение
    install -Dm755 "$srcdir/$pkgname" "$pkgdir/usr/bin/$pkgname"

    # 4. Устанавливаем .desktop файл, udev правило и иконку
    install -Dm644 "$srcdir/pad-key-mapper.desktop" "$pkgdir/usr/share/applications/pad-key-mapper.desktop"
    install -Dm644 99-padkey-mapper.rules "$pkgdir/usr/lib/udev/rules.d/99-padkey-mapper.rules"
    install -Dm644 "$srcdir/$PKMICON" "$pkgdir/usr/share/icons/hicolor/scalable/apps/PKMPPR.svg"
}
